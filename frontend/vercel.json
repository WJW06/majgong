{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://168.107.10.240:8080/api/$1"
    },
    {
      "source": "/source/(.*)",
      "destination": "http://168.107.10.240:8080/source/$1"
    },
    {
      "source": "/login/oauth2/(.*)",
      "destination": "http://168.107.10.240:8080/login/oauth2/$1"
    },
    {
      "source": "/oauth2/authorization/(.*)",
      "destination": "http://168.107.10.240:8080/oauth2/authorization/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

